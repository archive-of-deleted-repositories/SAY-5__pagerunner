{
  "name": "pagerunner",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:cov": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "eval": "tsx eval/cli.ts",
    "bench-eval": "tsx eval/bench.ts",
    "bench": "tsx bench/bench.ts",
    "bench:cheap": "tsx bench/bench.ts --provider anthropic --model claude-haiku",
    "bench-regress": "tsx bench/bench-regress.ts",
    "replay": "tsx apps/runner/src/cli/replay.ts",
    "replay:smoke": "tsx apps/runner/src/cli/replay-smoke.ts",
    "replay:build-golden": "tsx apps/runner/src/cli/build-golden-traces.ts",
    "migrate": "tsx packages/db/src/migrate.ts",
    "seed": "tsx packages/db/src/seed.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.2.1",
    "fast-check": "^3.23.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.2",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
